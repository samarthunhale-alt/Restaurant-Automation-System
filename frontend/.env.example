# Application Information
VITE_APP_NAME="Restaurant Automation"
VITE_APP_ENV="development"

# API Configuration
# Base URL for the backend API (v1)
VITE_API_URL="https://restaurant-automation-system-ntaq.onrender.com/api/v1"

# Socket Configuration
# URL for real-time socket.io connections
VITE_SOCKET_URL="https://restaurant-automation-system-ntaq.onrender.com"

# External Services
# Sentry DSN for error tracking (Optional)
VITE_SENTRY_DSN=""

# Feature Flags
VITE_ENABLE_NOTIFICATIONS="true"
VITE_ENABLE_ANALYTICS="false"
