{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "node_modules",
    "src/tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}